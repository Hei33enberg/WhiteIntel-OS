{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.whiteintel/whiteintel",
  "title": "WhiteIntel — Ownership Intelligence",
  "description": "UBO, sanctions & ownership graph. 23 tools, 130.7M entities, 31 registries.",
  "version": "0.7.9",
  "websiteUrl": "https://whiteintel.dev",
  "repository": {
    "url": "https://github.com/Hei33enberg/WhiteIntel-OS",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@whiteintel/mcp-server",
      "version": "0.7.9",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "WHITEINTEL_API_KEY",
          "description": "Optional wi_ API key (whiteintel.dev, Settings, API keys). Lifts free-tier limits to your plan.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "WHITEINTEL_API_BASE",
          "description": "API origin (SSRF-guarded to whiteintel.dev hosts).",
          "isRequired": false,
          "default": "https://whiteintel.dev"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://whiteintel.dev/api/mcp"
    }
  ]
}
